# ─────────────────────────────────────────────────────────────
#  JARVIS 2.0 – Konfiguration
#  Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.
#  Die .env wird NIE ins Git übernommen und NIE an den Browser gesendet.
# ─────────────────────────────────────────────────────────────

# PFLICHT: Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Sprachmodell & Denkaufwand (low = schnellste Sprachantworten)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT_VOICE=low
JARVIS_EFFORT_TASK=high

# ── Spracherkennung (STT) ────────────────────────────────────
# Empfohlen: Deepgram Streaming (deutsch, sehr geringe Latenz) – https://console.deepgram.com
# Ohne Schlüssel wird die Spracherkennung des Browsers (Chrome/Edge) verwendet.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# JARVIS_ENDPOINTING_MS=450
# JARVIS_UTTERANCE_END_MS=1100

# ── Sprachausgabe (TTS) ──────────────────────────────────────
# Empfohlen: ElevenLabs (natürlichste Stimme) – https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Stimme: Standard "Daniel" (ruhig, männlich). Eigene Voice-ID aus der ElevenLabs Voice Library möglich.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_MODEL=eleven_flash_v2_5        # schnell; alternativ eleven_multilingual_v2 (noch natürlicher, langsamer)

# Alternative: OpenAI TTS (Stimme "onyx")
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=onyx

# Erzwinge Provider (elevenlabs | openai | browser), sonst automatisch
# JARVIS_TTS=
JARVIS_VOICE_SPEED=1.0

# ── Wake-Word "Jarvis" ───────────────────────────────────────
# Kostenloser AccessKey: https://console.picovoice.ai  → rein lokale Erkennung im Browser
# Danach einmalig: npm run setup:wakeword
PICOVOICE_ACCESS_KEY=
# JARVIS_WAKE_SENSITIVITY=0.6
# Wie lange Jarvis nach einer Antwort ohne Wake-Word weiter zuhört (ms)
JARVIS_FOLLOWUP_MS=8000

# ── Persönliches ─────────────────────────────────────────────
JARVIS_USER_NAME=
# JARVIS_TIMEZONE=Europe/Berlin

# Kalender: iCal-Adresse(n), mehrere mit ; trennen
# Google Kalender → Einstellungen → Kalender → "Privatadresse im iCal-Format"
JARVIS_CALENDAR_ICS=

# ── Zugriff ──────────────────────────────────────────────────
# Ordner, auf die Jarvis zugreifen darf (Standard: Benutzerordner), mehrere mit ; trennen
# JARVIS_FILE_ROOTS=~/Documents;~/Projekte
# Ausgabeordner für Berichte/Dateien von Jarvis
# JARVIS_OUTPUT_DIR=~/Jarvis
# Shell-Befehle erlauben (immer mit Bestätigung)
JARVIS_ALLOW_SHELL=true

# Browsersteuerung: installierten Chrome/Edge nutzen statt "npm run setup:browser"
# JARVIS_BROWSER_CHANNEL=chrome
# JARVIS_BROWSER_HEADLESS=false

# Server (nur lokal erreichbar lassen!)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=7777
